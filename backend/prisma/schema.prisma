generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  WORKER
  ADMIN
}

/// User-level account access restriction — deliberately separate from
/// WorkerStatus (Worker-only job-eligibility gate) and from
/// deletedAt/isActive (account deletion). Only ACTIVE/SUSPENDED by design;
/// no BLOCKED/BANNED variants. Only ever meaningfully set on CLIENT
/// accounts — see User.accountStatus doc comment.
enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
  AWAITING_CONFIRMATION
  SETTLED
}

enum CancelledByRole {
  CLIENT
  WORKER
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Authoritative lifecycle for a service category when it is offered to new
/// Workers during registration. `isActive` is retained as a legacy Client
/// visibility mirror for older APKs; new Worker-selection logic reads only
/// this enum.
enum ServiceAvailabilityStatus {
  ACTIVE
  INACTIVE
  SOON
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Ustaad onboarding/admin-review state machine. This is the authoritative
/// gate for hireability (go online, matching, bidding, direct hire) —
/// replacing the old verificationStatus-only gate. verificationStatus is
/// kept on the schema (still mirrored by admin approve/reject) but no
/// gating logic reads it anymore.
enum WorkerOnboardingStatus {
  DRAFT
  SUBMITTED_FOR_REVIEW
  CHANGES_REQUIRED
  REJECTED
  APPROVED
}

/// Manual admin review of CNIC photos vs. live selfie. No automatic face
/// recognition is implemented — this is set by an admin only.
enum FaceMatchStatus {
  PENDING
  MATCHED
  NOT_MATCHED
  NEEDS_REVIEW
}

enum TrainingStatus {
  NOT_STARTED
  INVITED
  COMPLETED
  NEEDS_RETRAINING
}

enum AgreementType {
  GENERAL_USTAAD
  TRADE_SPECIFIC
  /// Background Verification, EVS Consent aur Ustaad Privacy Notice — the
  /// third document every Ustaad accepts at profile completion.
  BACKGROUND_VERIFICATION_EVS_PRIVACY_NOTICE
  /// Registered for a future, separate Customer acceptance flow. MUST NEVER
  /// be shown to, required from, or accepted by an Ustaad.
  CUSTOMER_TERMS_BOOKING_RULES_PRIVACY_NOTICE
}

/// Language of one agreement version. Values mirror the app's existing locale
/// identifiers (AppLocale.storageValue): en / ur / ur_Latn.
enum AgreementLocale {
  EN
  UR
  UR_LATN
}

/// Lifecycle of one document-language version.
///
/// Only ACTIVE may be viewed or accepted. PENDING_TRANSLATION means the
/// variant is expected but its certified legal text does not exist yet — it
/// can never be shown to an Ustaad or sealed into an acceptance record.
enum AgreementSourceStatus {
  ACTIVE
  PENDING_TRANSLATION
  DRAFT
  RETIRED
}

/// Trades with an approved schedule in the Trade-Specific agreement.
/// Selected by stable code, never by comparing translated category names.
enum AgreementTradeCode {
  ELECTRICIAN
  PLUMBER
  AC_TECHNICIAN
  CARPENTER
}

/// How an acceptance was captured. Only electronic acceptance through the
/// HandyGo app is supported today; the enum exists so the record stays
/// meaningful if a counter-signed paper route is ever added.
enum AgreementAcceptanceMethod {
  ELECTRONIC_IN_APP
}

enum BookingUrgency {
  URGENT
  NORMAL
}

enum UrgentWindow {
  WITHIN_1_HOUR
  WITHIN_2_HOURS
  WITHIN_4_HOURS
}

enum TimeSlot {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Whether HandyGo's 18% platform commission for one completed job has been
/// settled/recorded by admin. Independent of PaymentStatus (which tracks the
/// client's payment for the job itself) and independent of the Ustaad
/// earning formula — Ustaad earning is always Gross - Commission regardless
/// of whether this is PENDING or PAID.
enum CommissionStatus {
  PENDING
  PAID
}

/// Who supplied the received-cash figure used for an immutable settlement.
/// OTP is reserved for a future flow and is deliberately unused in this phase.
enum SettlementSource {
  OTP
  USTAAD
  CLIENT
  ADMIN
}

enum SettlementCaseType {
  SHORT
  UNPAID_LABOUR
  UNPAID_FEE
}

enum SettlementCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SettlementCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SettlementCaseEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  NOTE_ADDED
  CONTACT_ATTEMPTED
  COLLECTION_CREATED
  RESOLVED
  REOPENED
}

enum ComplaintIssueType {
  WORK_QUALITY
  PRICE_PAYMENT
  USTAAD_BEHAVIOUR
  DAMAGE
  PART_MATERIAL
  WARRANTY_REWORK
  OTHER
}

enum ComplaintSource {
  APP_CUSTOMER
  APP_WORKER
  WEBSITE_BOT
  WHATSAPP_BOT
  EMAIL
  ADMIN
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ComplaintEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
  HUMAN_REQUESTED
  RESOLVED
  REOPENED
}

enum ContactChannel {
  PHONE
  SMS
  WHATSAPP
  EMAIL
  OTHER
}

enum ContactOutcome {
  REACHED
  NO_ANSWER
  PROMISED_PAYMENT
  DISPUTED
  WRONG_NUMBER
  OTHER
}

enum CommissionCollectionStatus {
  PENDING
  COLLECTED
  FAILED
  CANCELLED
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
  LOCATION
  SYSTEM
}

enum AvailabilityStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum BookingLane {
  STANDARD
  INSPECTION
  BIDDING
}

enum InspectionDecisionStatus {
  PENDING_CLIENT_DECISION
  ACCEPTED_REPAIR
  CLOSED_AFTER_INSPECTION
  /// Customer paid the inspection fee and opted to find a different Ustaad
  /// to perform the work — the booking reopens for bidding while the
  /// original InspectionReport (and its workerProfileId/quote) is preserved
  /// untouched. Reverts to ACCEPTED_REPAIR if the customer ends up re-hiring
  /// the same inspecting worker anyway.
  FIND_OTHER_USTAAD
}

model User {
  id                 String    @id @default(uuid())
  phone              String    @unique
  email              String?   @unique
  passwordHash       String?
  role               Role
  isActive           Boolean   @default(true)
  fcmToken           String?
  /// App-selected language used when rendering persisted/push notifications.
  /// BCP-47 values currently supported: en, ur, ur_Latn. Roman Urdu remains
  /// the backward-compatible default for accounts registered by older apps.
  notificationLocale String    @default("ur_Latn")
  /// Whether this phone number has ever completed a real OTP verification.
  /// Defaults to false for every row (including pre-existing accounts) —
  /// deliberately not backfilled for historical OTP-verified accounts (see
  /// migration notes); set true going forward by a successful OTP
  /// login/registration (Client or Worker), never by a password login or
  /// password-based registration.
  phoneVerified      Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  /// Account-level access restriction, distinct from WorkerStatus (which
  /// governs Worker job-matching eligibility) and from deletedAt/isActive
  /// (which govern account deletion). Only meaningful for CLIENT accounts
  /// today — set exclusively via the admin account-status endpoint, never
  /// by Worker approval/suspension flows. A SUSPENDED client can still
  /// authenticate (so the app can identify and route them to the
  /// restricted-account screen) but is blocked from every other app
  /// surface client-side. updatedAt above doubles as the audit timestamp
  /// for the last account-status change.
  accountStatus AccountStatus @default(ACTIVE)

  clientProfile        ClientProfile?
  workerProfile        WorkerProfile?
  refreshTokens        RefreshToken[]
  notifications        Notification[]
  passwordResetOtps    PasswordResetOtp[]
  agreementAcceptances AgreementAcceptance[]

  conversationsAsClient        Conversation[]             @relation("ClientConversations")
  conversationsAsWorker        Conversation[]             @relation("WorkerConversations")
  chatMessages                 Message[]                  @relation("ChatMessages")
  settlementsSettled           BookingSettlement[]        @relation("SettlementSettledBy")
  settlementCasesAssigned      SettlementCase[]           @relation("SettlementCaseAssignee")
  settlementCaseEvents         SettlementCaseEvent[]      @relation("SettlementCaseEventActor")
  settlementCaseNotes          SettlementCaseNote[]       @relation("SettlementCaseNoteAuthor")
  settlementContactAttempts    SettlementContactAttempt[] @relation("SettlementContactActor")
  commissionCollectionsCreated CommissionCollection[]     @relation("CommissionCollectionCreator")
  complaintsReported           Complaint[]                @relation("ComplaintReporter")
  complaintsAssigned           Complaint[]                @relation("ComplaintAssignee")
  complaintEvents              ComplaintEvent[]           @relation("ComplaintEventActor")

  @@map("users")
}

model PasswordResetOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String
  otpHash    String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([phone])
  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
  @@map("password_reset_otps")
}

enum AuthOtpPurpose {
  CLIENT_LOGIN_REGISTER
  WORKER_REGISTER
  WORKER_LOGIN
}

/// Purpose-scoped OTP for the SMS login/registration flows — deliberately
/// separate from PasswordResetOtp (different lifecycle/callers) and not
/// FK'd to User, since CLIENT_LOGIN_REGISTER/WORKER_REGISTER OTPs are
/// requested before any account exists for that phone.
model AuthOtp {
  id         String         @id @default(cuid())
  phone      String
  purpose    AuthOtpPurpose
  otpHash    String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int            @default(0)
  requestIp  String?
  createdAt  DateTime       @default(now())

  /// Whether SmsOtpService actually dispatched this code through the SMS
  /// provider (STATUS === 'SUCCESSFUL'). False when running without SMS
  /// configured (dev — the code was only logged, never sent). Diagnostics
  /// only — never read by requestOtp()/_verifyAuthOtp()'s actual logic.
  smsDispatched Boolean @default(false)

  /// AES-256-GCM encrypted copy of the plaintext code, decryptable ONLY by
  /// the Admin OTP-reveal endpoint (OTP_ADMIN_ENCRYPTION_KEY — see
  /// otp-encryption.util.ts). Exists solely so an admin can manually relay a
  /// code whose SMS never reached the handset. All three are null when the
  /// encryption key wasn't configured at issuance time (that OTP is simply
  /// not revealable) or on legacy pre-migration rows.
  ///
  /// Normal OTP verification NEVER reads these — it continues to use
  /// otpHash (bcrypt) exactly as before this field existed.
  otpCiphertext String?
  otpCipherIv   String?
  otpCipherTag  String?

  @@index([phone, purpose])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([requestIp, createdAt])
  @@map("auth_otps")
}

/// Permanent audit trail for the one high-risk admin action this table
/// exists for: an admin decrypting and viewing a still-active OTP so it can
/// be manually relayed to a user whose SMS never arrived. Deliberately
/// narrow (OTP-reveal only) rather than a general admin-audit-log — see
/// AdminOtpService.reveal. The revealed plaintext OTP is never written here.
model OtpRevealAuditLog {
  id          String         @id @default(cuid())
  /// Not a relation to User on purpose — this row must remain a permanent,
  /// unmodifiable record of who looked at what, even if the admin account is
  /// later deleted.
  adminUserId String
  authOtpId   String
  /// The phone this OTP belonged to — audit context, never the revealed code.
  targetPhone String
  purpose     AuthOtpPurpose
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())

  @@index([adminUserId])
  @@index([authOtpId])
  @@index([createdAt])
  @@map("otp_reveal_audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  /// Set the instant this token is rotated away (replaced by a newer one)
  /// instead of being deleted outright. Kept for a short grace window so a
  /// client that crashed/was killed after the backend rotated but before it
  /// could persist the new pair locally can safely retry with this same
  /// (now-superseded) token and recover — see AuthService.refreshTokens.
  replacedByToken String?
  /// When this token was superseded. Null means it has never been rotated.
  supersededAt    DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}

model ClientProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  avatarUrl        String?
  avatarStorageKey String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookings             Booking[]
  addresses            ClientAddress[]
  agreementAcceptances AgreementAcceptance[]

  @@map("client_profiles")
}

model ClientAddress {
  id              String        @id @default(uuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  label           String
  /// Server-generated, trimmed/collapsed/lowercase label used for per-client
  /// case-insensitive uniqueness. Clients never choose this value directly.
  normalizedLabel String
  addressLine     String
  city            String
  latitude        Float
  longitude       Float
  isDefault       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([clientProfileId, normalizedLabel])
  @@index([clientProfileId])
  @@map("client_addresses")
}

model WorkerProfile {
  id                 String                                 @id @default(uuid())
  userId             String                                 @unique
  user               User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  avatarUrl          String?
  avatarStorageKey   String?
  bio                String?
  status             WorkerStatus                           @default(ACTIVE)
  verificationStatus VerificationStatus                     @default(PENDING)
  isOnline           Boolean                                @default(false)
  profileCompleted   Boolean                                @default(false)
  availabilityStatus AvailabilityStatus                     @default(OFFLINE)
  onlineAt           DateTime?                              @db.Timestamptz(3)
  /// Server-observed "this Worker's app is genuinely active" timestamp —
  /// distinct from onlineAt (set once per Go-Online session) and from
  /// locationUpdatedAt (GPS freshness, used for nearby-radius matching).
  /// Refreshed only by legitimate Worker activity (go online, presence
  /// sync, live-location ping while ONLINE) via touchWorkerPresence — never
  /// by Client/Admin actions or background jobs. Used to expire a stale
  /// ONLINE lease (see WORKER_ONLINE_STALE_HOURS) independently of GPS
  /// freshness, which remains a separate, stricter check.
  lastSeenAt         DateTime?                              @db.Timestamptz(3)
  /// When this Worker last OPENED the "Naye Kaam" (New Jobs) screen.
  ///
  /// Not presence and not GPS: this is the read-marker the Naye Kaam badge
  /// counts against. A matching job created after this instant is unread; one
  /// created before it is not. Nullable and defaulted to NULL on purpose —
  /// an existing Worker who has never opened the screen since this column
  /// shipped simply has every job in the 24h window unread, which is the
  /// truthful answer, not a migration artefact.
  ///
  /// Stamped only by POST /workers/jobs/new/seen, i.e. by the Worker's own
  /// act of opening the screen. Nothing else writes it — not a background
  /// job, not a fan-out, not the Client side — so it can never drift away
  /// from what the Worker has actually looked at.
  newJobsSeenAt      DateTime?                              @db.Timestamptz(3)
  currentlyWorking   Boolean                                @default(false)
  currentLat         Float?
  currentLng         Float?
  /// PostGIS mirror of (currentLng, currentLat), maintained by the database
  /// itself as a STORED generated column — there is no application write path
  /// and therefore nothing that can drift out of sync with currentLat/
  /// currentLng, which remain the authoritative, backward-compatible source.
  ///
  /// Prisma cannot model the `geography` type, so it is declared Unsupported:
  /// it never appears in the generated client, is never read or written by
  /// Prisma, and exists purely so the GIST-indexed `ST_DWithin` radius query
  /// in BookingsRepository can run in the database. Only used when
  /// USE_POSTGIS=true; the Haversine + bounding-box path is unaffected.
  location           Unsupported("geography(Point, 4326)")?
  locationUpdatedAt  DateTime?                              @db.Timestamptz(3)
  rating             Float                                  @default(0)
  totalRatings       Int                                    @default(0)
  createdAt          DateTime                               @default(now())
  updatedAt          DateTime                               @updatedAt

  // ── Ustaad onboarding / profile completion ────────────────────────────
  fullLegalName        String?
  /// CNIC number (e.g. 12345-1234567-1) — unique across workers. Nullable
  /// column with a unique index is safe: Postgres allows multiple NULLs.
  cnicNumber           String? @unique
  residentialAddress   String?
  /// Father's name as per CNIC. Required by the Background Verification /
  /// EVS Consent document, which cannot be generated without it.
  fatherName           String?
  /// Date of birth as per CNIC, stored as the ISO date the Ustaad entered
  /// (yyyy-MM-dd). Required by the EVS Consent document.
  dateOfBirth          String?
  /// Optional "name, phone" emergency contact. Prints as a controlled
  /// "Not applicable" in the EVS document when absent.
  emergencyContact     String?
  cnicFrontUrl         String?
  cnicFrontStorageKey  String?
  cnicBackUrl          String?
  cnicBackStorageKey   String?
  liveSelfieUrl        String?
  liveSelfieStorageKey String?

  faceMatchStatus  FaceMatchStatus        @default(PENDING)
  trainingStatus   TrainingStatus         @default(NOT_STARTED)
  onboardingStatus WorkerOnboardingStatus @default(DRAFT)

  legalNameConfirmedAt       DateTime? @db.Timestamptz(3)
  generalAgreementAcceptedAt DateTime? @db.Timestamptz(3)
  tradeAgreementAcceptedAt   DateTime? @db.Timestamptz(3)
  generalAgreementVersion    String?
  tradeAgreementVersion      String?

  submittedForReviewAt  DateTime? @db.Timestamptz(3)
  changesRequiredReason String?
  rejectionReason       String?

  skills                WorkerSkill[]
  documents             WorkerDocument[]
  bookings              Booking[]
  bookingSettlements    BookingSettlement[]
  settlementCases       SettlementCase[]
  commissionCollections CommissionCollection[]
  bids                  Bid[]
  bookingExclusions     BookingWorkerExclusion[]
  inspectionReports     InspectionReport[]
  agreementAcceptances  AgreementAcceptance[]
  reportedComplaints    Complaint[]              @relation("ComplaintReportedWorker")

  /// Supports the stale-ONLINE cleanup scan (WHERE availabilityStatus =
  /// ONLINE AND lastSeenAt < cutoff) and the matching-time freshness check.
  @@index([availabilityStatus, lastSeenAt])
  /// LIVE-matching candidate filter (MatchingRepository.findCandidateWorkers and
  /// BookingsRepository.findNearbyWorkers, both paths):
  ///   WHERE availabilityStatus = 'ONLINE' AND currentlyWorking = FALSE
  ///     AND status = 'ACTIVE' AND onboardingStatus = 'APPROVED'
  ///     AND locationUpdatedAt >= cutoff AND lastSeenAt >= cutoff ...
  /// The existing (availabilityStatus, lastSeenAt) index cannot serve this:
  /// its second column is a range, so the equality predicates on
  /// currentlyWorking/status/onboardingStatus can never be used as index
  /// keys and every ONLINE row had to be heap-fetched and rechecked. Leading
  /// with the four equality columns makes locationUpdatedAt the single
  /// trailing range, which is the only shape Postgres can use end to end.
  @@index([availabilityStatus, currentlyWorking, status, onboardingStatus, locationUpdatedAt], map: "worker_profiles_live_candidate_idx")
  /// Geographic pre-filter for the non-PostGIS candidate query, which now
  /// applies a lat/lng bounding box in SQL before any distance maths. Without
  /// this the bounding box still had to scan every row it was filtering.
  @@index([currentLat, currentLng], map: "worker_profiles_bbox_idx")
  /// GIST index backing `ST_DWithin(wp.location, $job, $radius)` on the
  /// PostGIS path. The previous PostGIS query built the geography inline from
  /// currentLng/currentLat, which is an expression no index can serve — every
  /// radius rung was a sequential scan of the whole table.
  @@index([location], type: Gist, map: "worker_profiles_location_gist_idx")
  @@map("worker_profiles")
}

model WorkerSkill {
  id              String          @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile   @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id])
  yearsExperience Int             @default(0)
  createdAt       DateTime        @default(now())

  @@unique([workerProfileId, categoryId])
  /// Kept: still the only support for "which categories does this skill row
  /// belong to" style lookups that start from categoryId alone.
  @@index([categoryId])
  /// Skill matching runs `EXISTS (SELECT 1 FROM worker_skills WHERE
  /// categoryId = $1 AND workerProfileId = wp.id)` (raw SQL) / `skills: {
  /// some: { categoryId } }` (Prisma) for every candidate worker. Neither
  /// existing index covers both columns in that order — the unique index is
  /// keyed workerProfileId-first, and the categoryId index forces a heap
  /// fetch per matching skill row. This one answers the semi-join from the
  /// index alone.
  @@index([categoryId, workerProfileId], map: "worker_skills_category_worker_idx")
  @@map("worker_skills")
}

model WorkerDocument {
  id              String        @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  type            String
  fileUrl         String
  storageKey      String?
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())

  @@index([workerProfileId])
  @@map("worker_documents")
}

model ServiceCategory {
  id                 String                    @id @default(uuid())
  name               String                    @unique
  description        String?
  iconUrl            String?
  /// Legacy Client-list visibility retained for older APKs. Worker
  /// registration uses availabilityStatus exclusively.
  isActive           Boolean                   @default(true)
  availabilityStatus ServiceAvailabilityStatus @default(ACTIVE)
  /// Fixed fee charged for an inspection-lane booking in this category.
  /// Null means inspection is not offered for this category.
  inspectionFee      Float?
  /// LEGACY lane restriction: when true this category offers the INSPECTION
  /// lane and nothing else.
  ///
  /// Superseded by [soleLane], which can name any single lane, but retained
  /// rather than dropped — it is still returned by /categories, and an older
  /// APK that only knows this field must keep working. [soleLane] takes
  /// precedence; this is consulted only when [soleLane] is null.
  inspectionOnly     Boolean                   @default(false)
  /// The ONE lane this category offers, when it is restricted to a single
  /// lane. Null — the default — means fall through to [inspectionOnly], and
  /// failing that the category is unrestricted and its lanes are decided the
  /// way they always were: BIDDING always, INSPECTION when [inspectionFee] is
  /// set, STANDARD from its fixed-price catalog.
  ///
  /// This generalises [inspectionOnly], which could only ever say "inspection
  /// and nothing else". Appliances Repair is BIDDING-only — an appliance
  /// fault cannot be quoted from a catalog, and the platform no longer sells
  /// a paid inspection for it — which that boolean cannot express.
  ///
  /// The resolution order is exactly:
  ///
  ///   1. soleLane set     → that lane, and nothing else.
  ///   2. else inspectionOnly → INSPECTION only (legacy behaviour, verbatim).
  ///   3. else             → unrestricted.
  ///
  /// The client app renders only the resolved lane; the rule is enforced
  /// server-side (see `assertLaneAllowed` in categories/category-lanes.ts)
  /// because an older build, a replayed request or a direct API call must not
  /// be able to open a booking in a lane the category does not offer.
  soleLane           BookingLane?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  bookings           Booking[]
  workerSkills       WorkerSkill[]
  standardServices   StandardService[]
  agreementTemplates AgreementTemplate[]

  @@index([availabilityStatus])
  @@map("service_categories")
}

model StandardService {
  id          String          @id @default(uuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  iconUrl     String?
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  bookings     Booking[]
  bookingItems BookingStandardServiceItem[]

  @@index([categoryId])
  @@map("standard_services")
}

model Booking {
  id              String          @id @default(uuid())
  clientProfileId String
  clientProfile   ClientProfile   @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  workerProfileId String?
  workerProfile   WorkerProfile?  @relation(fields: [workerProfileId], references: [id], onDelete: SetNull)
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id])

  status             BookingStatus    @default(PENDING)
  /// Booking lane: STANDARD (fixed-price catalog), INSPECTION (fixed inspection
  /// fee), or BIDDING (open worker bidding). Existing rows default to BIDDING,
  /// preserving current behavior.
  lane               BookingLane      @default(BIDDING)
  urgency            BookingUrgency   @default(NORMAL)
  timeSlot           TimeSlot?
  urgentWindow       UrgentWindow?
  title              String?
  description        String
  inspection         Boolean          @default(false)
  addressLine        String
  city               String
  latitude           Float
  longitude          Float
  scheduledAt        DateTime?
  acceptedAt         DateTime?
  enRouteAt          DateTime?
  arrivedAt          DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  /// Who initiated the cancellation. Null for non-cancelled bookings, for
  /// EXPIRED bookings (expiry is not a cancellation), and for historical
  /// cancelled rows predating this field.
  cancelledByRole    CancelledByRole?

  /// 72h auto-expiry window for PENDING bookings across all lanes. Set at
  /// creation and reset on relist; the BullMQ expiry job's delay is derived
  /// from this timestamp.
  expiresAt     DateTime?
  /// When the current live/searching window started (creation, or last relist).
  liveStartedAt DateTime?
  /// Last time the client used "Make Live Again" on an EXPIRED booking.
  relistedAt    DateTime?

  /// STANDARD lane: the catalog item picked at booking time (nullable — the
  /// item may later be deleted; the price/name snapshots below remain intact).
  standardServiceId            String?
  standardService              StandardService? @relation(fields: [standardServiceId], references: [id], onDelete: SetNull)
  /// STANDARD lane snapshot — captured at create time so later admin price
  /// edits never retroactively change an existing booking.
  standardServiceNameSnapshot  String?
  standardServicePriceSnapshot Float?
  /// INSPECTION lane snapshot — the category's inspectionFee at create time.
  inspectionFeeSnapshot        Float?

  estimatedPrice Float?
  finalPrice     Float?
  platformFee    Float?

  /// Whether HandyGo's 18% platform commission on this job has been
  /// settled/recorded by admin. Belongs to this individual completed job,
  /// never to the whole Worker account — three completed jobs for the same
  /// worker can carry three independent statuses. Set to PAID only when an
  /// immutable CommissionCollection reaches COLLECTED; defaults PENDING
  /// (irrelevant until the booking actually completes).
  commissionStatus          CommissionStatus @default(PENDING)
  /// When commissionStatus was last changed by an admin. Null until the
  /// first update.
  commissionStatusUpdatedAt DateTime?        @db.Timestamptz(3)

  /// Set only on a new BIDDING-lane booking spawned when "Find Other Ustaad"
  /// closes an inspection — points back to the now-COMPLETED inspection
  /// booking this repair job was created from. Null for every other booking,
  /// including all pre-existing rows (nothing populates it retroactively).
  sourceInspectionBookingId String?  @unique
  sourceInspectionBooking   Booking? @relation("InspectionRepairLink", fields: [sourceInspectionBookingId], references: [id], onDelete: SetNull)
  /// Back-relation: the repair booking spawned from this inspection, if any.
  repairBooking             Booking? @relation("InspectionRepairLink")

  /// Optional, purely INFORMATIONAL reference to a previously COMPLETED
  /// inspection booking whose report the client manually attached while
  /// independently posting this BIDDING job — supporting context for bidders,
  /// nothing more.
  ///
  /// Deliberately SEPARATE from sourceInspectionBookingId above, which means
  /// "this repair job was SPAWNED from that inspection" and drives real
  /// business behavior: worker labour-cost earnings override, the
  /// inspection-fee-paid derivation, original-inspector bidding exclusion,
  /// BIDDING_LINKED notification copy, and Find-Other-Ustaad idempotency.
  /// NONE of those apply here — the original inspection was closed and paid,
  /// and the original inspecting Ustaad is explicitly still allowed to bid on
  /// this new job.
  ///
  /// Intentionally NOT @unique (unlike sourceInspectionBookingId): one
  /// historical report may be attached to any number of future bidding jobs.
  /// onDelete: SetNull so removing either side never mutates the other.
  attachedInspectionBookingId String?
  attachedInspectionBooking   Booking?  @relation("AttachedInspectionRef", fields: [attachedInspectionBookingId], references: [id], onDelete: SetNull)
  /// Back-relation: later bidding jobs that attached this inspection's report.
  attachedByBookings          Booking[] @relation("AttachedInspectionRef")

  paymentStatus PaymentStatus @default(PENDING)

  /// Client-generated UUID for one booking-creation submission attempt.
  /// A retried "Create Booking" request (timeout, lost response) reuses the
  /// same key, so the second request returns the already-created booking
  /// instead of creating a duplicate. Null for bookings created before this
  /// field existed and for any client that omits it.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory        BookingStatusHistory[]
  attachments          BookingAttachment[]
  review               Review?
  bids                 Bid[]
  standardServiceItems BookingStandardServiceItem[]
  workerExclusions     BookingWorkerExclusion[]
  inspectionReport     InspectionReport?
  settlements          BookingSettlement[]
  settlementCases      SettlementCase[]
  complaint            Complaint?

  @@index([clientProfileId])
  @@index([workerProfileId])
  @@index([categoryId])
  @@index([status])
  @@index([urgency])
  @@index([scheduledAt])
  @@index([lane])
  @@index([standardServiceId])
  @@index([expiresAt])
  /// Supports resolving "which later bidding jobs attached this inspection"
  /// and keeps the FK lookup cheap. Not unique — see the field's own doc.
  @@index([attachedInspectionBookingId])
  /// The New Jobs discovery query — the hottest read in the Worker app
  /// (BidsRepository.findAvailableJobsForWorker and
  /// MatchingRepository.findOpenBookingsForCategories):
  ///   WHERE status = 'PENDING' AND categoryId IN (...) AND createdAt >= cutoff
  ///   ORDER BY createdAt DESC
  /// The single-column @@index([status]) is useless here (PENDING is a large,
  /// low-selectivity bucket) and @@index([categoryId]) still leaves the 48h
  /// window and the sort to a heap filter + sort node. Leading with the two
  /// equality columns makes createdAt both the range bound and the ordering
  /// key, so the discovery window is a bounded index range scan.
  @@index([status, categoryId, createdAt], map: "bookings_discovery_idx")
  /// Worker earnings/stats aggregation (computeCompletedJobs,
  /// computeCancellationRate, the batched nearby-worker stats groupBy) all run
  /// `WHERE workerProfileId IN (...) AND status = ...`. The existing
  /// @@index([workerProfileId]) alone re-checks status per heap row; adding
  /// status as the second key keeps those counts index-resident.
  @@index([workerProfileId, status], map: "bookings_worker_status_idx")
  @@map("bookings")
}

/// Append-only cash-settlement ledger. Rows have no updatedAt field and must
/// never be corrected in place; a correction inserts a new row whose
/// supersedesId points at the prior immutable record.
model BookingSettlement {
  id              String        @id @default(uuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Restrict)

  supersedesId String?            @unique
  supersedes   BookingSettlement? @relation("SettlementSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy BookingSettlement? @relation("SettlementSupersession")
  /// Lifecycle pointer used only to enforce one authoritative row per
  /// booking. Monetary snapshot fields remain immutable.
  isCurrent    Boolean            @default(true)

  expectedParts   Int
  expectedLabour  Int
  expectedFee     Int
  expectedTotal   Int
  received        Int
  source          SettlementSource
  partsPaid       Int
  labourPaid      Int
  feePaid         Int
  commission      Int
  munafa          Int
  shortfall       Int
  handygoPays     Int
  note            String?
  settledByUserId String
  settledBy       User                       @relation("SettlementSettledBy", fields: [settledByUserId], references: [id], onDelete: Restrict)
  settledAt       DateTime                   @default(now()) @db.Timestamptz(3)
  cases           SettlementCase[]
  collectionItems CommissionCollectionItem[]

  @@index([bookingId, settledAt])
  @@index([workerProfileId, settledAt])
  @@index([settledByUserId])
  @@map("booking_settlements")
}

/// Operational exception tracking around an immutable settlement. Money is
/// always read from settlementId; this row must never duplicate/recalculate it.
model SettlementCase {
  id               String                     @id @default(uuid())
  bookingId        String
  booking          Booking                    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  workerProfileId  String
  workerProfile    WorkerProfile              @relation(fields: [workerProfileId], references: [id], onDelete: Restrict)
  settlementId     String
  settlement       BookingSettlement          @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  type             SettlementCaseType
  status           SettlementCaseStatus       @default(OPEN)
  priority         SettlementCasePriority     @default(NORMAL)
  assignedToUserId String?
  assignedTo       User?                      @relation("SettlementCaseAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?                  @db.Timestamptz(3)
  createdAt        DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(3)
  events           SettlementCaseEvent[]
  notes            SettlementCaseNote[]
  contactAttempts  SettlementContactAttempt[]

  @@unique([settlementId, type])
  @@index([status, priority, createdAt])
  @@index([bookingId])
  @@index([workerProfileId])
  @@index([assignedToUserId])
  @@map("settlement_cases")
}

/// Append-only case lifecycle audit trail.
model SettlementCaseEvent {
  id          String                  @id @default(uuid())
  caseId      String
  case        SettlementCase          @relation(fields: [caseId], references: [id], onDelete: Restrict)
  type        SettlementCaseEventType
  actorUserId String
  actor       User                    @relation("SettlementCaseEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  metadata    Json?
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)

  @@index([caseId, createdAt])
  @@index([actorUserId])
  @@map("settlement_case_events")
}

/// Central support ticket used by every current and future complaint source.
/// A booking report is this row itself; there is no intermediate Report model.
model Complaint {
  id                      String               @id @default(uuid())
  /// Nullable for non-booking channels. PostgreSQL unique indexes allow many
  /// NULL values while enforcing exactly one Complaint per non-null booking.
  bookingId               String?              @unique
  booking                 Booking?             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  /// Nullable so an unauthenticated bot/email report can be represented later.
  reporterUserId          String?
  reporter                User?                @relation("ComplaintReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reportedWorkerProfileId String?
  reportedWorker          WorkerProfile?       @relation("ComplaintReportedWorker", fields: [reportedWorkerProfileId], references: [id], onDelete: SetNull)
  issueTypes              ComplaintIssueType[]
  otherText               String?
  source                  ComplaintSource
  status                  ComplaintStatus      @default(OPEN)
  priority                ComplaintPriority    @default(NORMAL)
  assignedToUserId        String?
  assignedTo              User?                @relation("ComplaintAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  humanRequested          Boolean              @default(false)
  humanRequestedAt        DateTime?            @db.Timestamptz(3)
  resolvedAt              DateTime?            @db.Timestamptz(3)
  createdAt               DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @db.Timestamptz(3)
  events                  ComplaintEvent[]

  @@index([status, priority, createdAt])
  @@index([reporterUserId])
  @@index([reportedWorkerProfileId])
  @@index([assignedToUserId])
  @@map("complaints")
}

/// Append-only lifecycle audit trail. No update/delete API is exposed.
model ComplaintEvent {
  id           String             @id @default(uuid())
  complaintId  String
  complaint    Complaint          @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  type         ComplaintEventType
  actorUserId  String?
  actor        User?              @relation("ComplaintEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  metadata     Json?
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  notification Notification?

  @@index([complaintId, createdAt])
  @@index([actorUserId])
  @@map("complaint_events")
}

/// Append-only internal note; edits are intentionally unsupported.
model SettlementCaseNote {
  id           String         @id @default(uuid())
  caseId       String
  case         SettlementCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  authorUserId String
  author       User           @relation("SettlementCaseNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  body         String
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([caseId, createdAt])
  @@index([authorUserId])
  @@map("settlement_case_notes")
}

/// Append-only record of an admin's attempt to contact a settlement party.
model SettlementContactAttempt {
  id          String         @id @default(uuid())
  caseId      String
  case        SettlementCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actorUserId String
  actor       User           @relation("SettlementContactActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  channel     ContactChannel
  outcome     ContactOutcome
  note        String?
  followUpAt  DateTime?      @db.Timestamptz(3)
  contactedAt DateTime       @default(now()) @db.Timestamptz(3)

  @@index([caseId, contactedAt])
  @@index([actorUserId])
  @@index([followUpAt])
  @@map("settlement_contact_attempts")
}

/// One immutable snapshot of a nightly commission collection attempt.
model CommissionCollection {
  id              String                     @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile              @relation(fields: [workerProfileId], references: [id], onDelete: Restrict)
  collectionDate  DateTime                   @db.Date
  amount          Int
  status          CommissionCollectionStatus @default(PENDING)
  /// Null only for the Bull-scheduled nightly system run. Manual fallback
  /// requests always retain the authenticated admin actor.
  createdByUserId String?
  createdBy       User?                      @relation("CommissionCollectionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  automated       Boolean                    @default(false)
  collectedAt     DateTime?                  @db.Timestamptz(3)
  failureReason   String?
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)
  items           CommissionCollectionItem[]

  @@unique([workerProfileId, collectionDate])
  @@index([status, collectionDate])
  @@index([createdByUserId])
  @@map("commission_collections")
}

model CommissionCollectionItem {
  id           String               @id @default(uuid())
  collectionId String
  collection   CommissionCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  settlementId String
  settlement   BookingSettlement    @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  amount       Int
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([collectionId, settlementId])
  @@index([settlementId])
  @@map("commission_collection_items")
}

/// Individual selected STANDARD-lane services for a booking. Supports
/// multiple sub-services per booking (e.g. AC General Service + AC
/// Dismounting). The legacy singular standardServiceId/snapshot fields on
/// Booking remain for backward compatibility; new STANDARD bookings populate
/// both the legacy fields (first/primary item) and this table.
model BookingStandardServiceItem {
  id                String           @id @default(uuid())
  bookingId         String
  booking           Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  standardServiceId String?
  standardService   StandardService? @relation(fields: [standardServiceId], references: [id], onDelete: SetNull)
  nameSnapshot      String
  priceSnapshot     Float
  quantity          Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([bookingId])
  @@index([standardServiceId])
  @@map("booking_standard_service_items")
}

/// Tracks workers who cancelled or were otherwise excluded from a specific
/// booking, so they are never re-offered/re-listed for that same booking
/// (survives relist via "Make Live Again").
model BookingWorkerExclusion {
  id              String        @id @default(uuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  reason          String?
  createdAt       DateTime      @default(now())

  @@unique([bookingId, workerProfileId])
  @@index([bookingId])
  @@index([workerProfileId])
  @@map("booking_worker_exclusions")
}

model BookingStatusHistory {
  id        String        @id @default(uuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    BookingStatus
  note      String?
  createdAt DateTime      @default(now())

  @@index([bookingId])
  @@map("booking_status_history")
}

model BookingAttachment {
  id              String         @id @default(uuid())
  bookingId       String
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type            AttachmentType
  url             String
  storageKey      String?
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  durationSeconds Float?
  thumbnailUrl    String?
  createdAt       DateTime       @default(now())

  @@index([bookingId])
  @@map("booking_attachments")
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

/// INSPECTION-lane worker report: findings + repair quote submitted after
/// on-site inspection. One report per booking. Client decides via
/// decisionStatus whether to continue repair with the same worker or close
/// the job at the inspection fee (see BookingsService.completeAfterInspectionClose).
model InspectionReport {
  id                       String                   @id @default(uuid())
  bookingId                String                   @unique
  booking                  Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  workerProfileId          String
  workerProfile            WorkerProfile            @relation(fields: [workerProfileId], references: [id])
  /// Either (issueFound & recommendedRepair) or a voice note must be present —
  /// enforced in InspectionReportsService, not at the DB level.
  issueFound               String?
  recommendedRepair        String?
  labourCost               Float
  partsNeeded              Boolean                  @default(false)
  partsTotal               Float                    @default(0)
  /// labourCost + partsTotal. Deliberately NOT reduced by the inspection fee
  /// already paid — the fee is shown separately in the UI as an informational line.
  repairQuoteTotal         Float
  notes                    String?
  voiceNoteUrl             String?
  voiceNoteStorageKey      String?
  voiceNoteMimeType        String?
  voiceNoteDurationSeconds Float?
  decisionStatus           InspectionDecisionStatus @default(PENDING_CLIENT_DECISION)
  acceptedAt               DateTime?
  closedAt                 DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  parts  InspectionReportPart[]
  photos InspectionReportPhoto[]

  @@index([workerProfileId])
  @@map("inspection_reports")
}

model InspectionReportPart {
  id        String           @id @default(uuid())
  reportId  String
  report    InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int              @default(1)
  unitPrice Float
  warranty  String?
  lineTotal Float
  createdAt DateTime         @default(now())

  @@index([reportId])
  @@map("inspection_report_parts")
}

model InspectionReportPhoto {
  id         String           @id @default(uuid())
  reportId   String
  report     InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  url        String
  storageKey String?
  createdAt  DateTime         @default(now())

  @@index([reportId])
  @@map("inspection_report_photos")
}

model Conversation {
  id                 String    @id @default(uuid())
  clientUserId       String
  clientUser         User      @relation("ClientConversations", fields: [clientUserId], references: [id], onDelete: Cascade)
  workerUserId       String
  workerUser         User      @relation("WorkerConversations", fields: [workerUserId], references: [id], onDelete: Cascade)
  /// The userId of whoever triggered the conversation creation
  createdByUserId    String
  lastMessageAt      DateTime?
  lastMessagePreview String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages Message[]

  @@unique([clientUserId, workerUserId])
  @@index([clientUserId])
  @@index([workerUserId])
  @@map("conversations")
}

model Message {
  id               String       @id @default(uuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId     String
  sender           User         @relation("ChatMessages", fields: [senderUserId], references: [id], onDelete: Cascade)
  senderRole       Role
  type             MessageType  @default(TEXT)
  text             String?
  mediaUrl         String?
  storageKey       String?
  thumbnailUrl     String?
  mimeType         String?
  fileName         String?
  sizeBytes        Int?
  durationSeconds  Float?
  latitude         Float?
  longitude        Float?
  /// Optional reference to a booking — for context only, not a hard FK
  bookingId        String?
  replyToMessageId String?
  replyTo          Message?     @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]    @relation("MessageReplies")
  editedAt         DateTime?
  deletedAt        DateTime?
  seenAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([conversationId])
  @@index([senderUserId])
  @@map("chat_messages")
}

model Notification {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  body             String
  data             Json?
  isRead           Boolean         @default(false)
  readAt           DateTime?
  eventKey         String?
  entityType       String?
  entityId         String?
  bookingId        String?
  actorUserId      String?
  actorRole        String?
  route            String?
  payload          Json?
  /// Exactly-once persistence key for Complaint lifecycle notifications.
  complaintEventId String?         @unique
  complaintEvent   ComplaintEvent? @relation(fields: [complaintEventId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([userId])
  @@index([userId, isRead])
  /// Broadcast dedup — runs once per (worker, job) pair in every fan-out
  /// (NotificationsRepository.existsForBookingAndUserSince / the new batched
  /// findNotifiedUserIdsForBooking):
  ///   WHERE bookingId = $1 AND eventKey = $2 AND userId IN (...)
  ///     AND createdAt >= liveStartedAt
  /// Previously this could only start from @@index([userId]) and then filter
  /// every one of that user's notifications by hand. Leading with bookingId
  /// (highly selective) collapses it to a handful of index entries.
  @@index([bookingId, eventKey, createdAt], map: "notifications_booking_event_idx")
  /// The notification history feed (findByUserId: WHERE userId ORDER BY
  /// createdAt DESC LIMIT 50). @@index([userId]) supplies the rows but not
  /// the order, so a heavy user forced a full sort of their history on every
  /// open of the bell icon.
  @@index([userId, createdAt], map: "notifications_user_created_idx")
  @@map("notifications")
}

model Bid {
  id              String        @id @default(uuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  message         String?
  status          BidStatus     @default(PENDING)
  editCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([bookingId, workerProfileId])
  @@index([bookingId])
  @@index([workerProfileId])
  @@map("bids")
}

/// A specific version of a legal agreement an Ustaad must accept.
/// categoryId is null for GENERAL_USTAAD (applies to all trades) and set for
/// TRADE_SPECIFIC (one per ServiceCategory). Templates are never deleted —
/// AgreementAcceptance.agreementTemplateId is a Restrict FK, and publishing a
/// new version means creating a NEW row with isActive=true while the old row
/// (and every acceptance that references it) is left untouched forever.
model AgreementTemplate {
  id             String           @id @default(uuid())
  type           AgreementType
  categoryId     String?
  category       ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title          String
  version        String
  contentText    String
  fileUrl        String?
  fileStorageKey String?
  /// SHA-256 of contentText, computed at creation — lets an acceptance record
  /// prove exactly which text was agreed to even if this row were ever
  /// (accidentally) edited in place.
  contentHash    String
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())

  // ── Language / trade / lifecycle ─────────────────────────────────────────
  // One row per (type, trade, locale). A language variant is a SEPARATE row,
  // never a column on a shared row, so each language has its own hash and an
  // acceptance can point at the exact wording that was shown.

  /// Defaults to UR_LATN: every pre-existing row was the Roman Urdu source.
  locale                 AgreementLocale       @default(UR_LATN)
  /// Only set for TRADE_SPECIFIC; null for the general and background docs.
  tradeCode              AgreementTradeCode?
  /// Only ACTIVE may be viewed or accepted. English/Urdu sit in
  /// PENDING_TRANSLATION until certified legal text passes parity validation.
  status                 AgreementSourceStatus @default(ACTIVE)
  /// Bumped only when clause identifiers/ordering change. Language variants
  /// of the same legal content share it — this is what parity compares.
  clauseStructureVersion String                @default("1.0")
  /// Provenance: the approved PDF this canonical text was ingested from.
  originalFilename       String?
  activatedAt            DateTime?
  retiredAt              DateTime?

  acceptances AgreementAcceptance[]

  @@unique([type, tradeCode, locale, version])
  @@index([type, categoryId, isActive])
  @@index([type, tradeCode, locale, status])
  @@map("agreement_templates")
}

/// Permanent legal audit record of one Ustaad accepting one specific
/// AgreementTemplate version. Never updated after creation and never
/// deleted — every field the agreement legally depends on (name, CNIC,
/// mobile, skill, document references, the agreement text itself) is
/// snapshotted here so the record remains meaningful even if the worker's
/// profile or the template later changes.
model AgreementAcceptance {
  id                  String             @id @default(uuid())
  /// Null for a CLIENT acceptance — exactly one of workerProfileId /
  /// clientProfileId is set, enforced in application code (Prisma has no
  /// declarative XOR constraint). Never both, never neither.
  workerProfileId     String?
  workerProfile       WorkerProfile?     @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  /// Null for a WORKER acceptance — see workerProfileId.
  ///
  /// SetNull, not Cascade: this row is permanent legal evidence of an
  /// electronic acceptance. Deleting/deactivating/closing the Client profile
  /// must never delete the signed record — it only unlinks it, and every
  /// identifying fact (name, mobile, account id, hashes, PDF reference,
  /// timestamps) survives on the immutable snapshot fields below.
  clientProfileId     String?
  clientProfile       ClientProfile?     @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  /// Nullable and SetNull for the same legal-preservation reason as
  /// clientProfileId: a deleted User account must not delete the acceptance
  /// record it made. userId is still always populated at creation time by
  /// application code — this is a schema-level survival guarantee, not a
  /// relaxation of what gets written.
  userId              String?
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Optional: acceptances created from the file-backed source registry have
  /// no AgreementTemplate row. Legacy rows keep theirs.
  agreementTemplateId String?
  agreementTemplate   AgreementTemplate? @relation(fields: [agreementTemplateId], references: [id], onDelete: Restrict)

  // Snapshot of the template at acceptance time (survives template changes).
  agreementType                   AgreementType
  agreementTitle                  String
  agreementVersion                String
  agreementContentSnapshot        String
  agreementFileSnapshotUrl        String?
  agreementFileSnapshotStorageKey String?
  agreementHash                   String

  // Snapshot of the worker's identity/profile at acceptance time. CNIC and
  // main skill are Worker-only concepts — null on a CLIENT row.
  fullLegalNameSnapshot   String
  cnicNumberSnapshot      String?
  mobileSnapshot          String
  mainSkillSnapshot       String?
  cnicFrontUrlSnapshot    String?
  cnicBackUrlSnapshot     String?
  liveSelfieUrlSnapshot   String?
  /// CLIENT-only: the customer account id shown in the accepted document.
  /// Null on a WORKER row.
  clientAccountIdSnapshot String?

  acceptedAt       DateTime @db.Timestamptz(3)
  ipAddress        String?
  deviceInfo       String?
  checkboxAccepted Boolean  @default(true)

  acceptancePdfUrl        String?
  acceptancePdfStorageKey String?

  // ── Language, trade and evidence of exactly what was accepted ────────────

  /// Public, human-quotable acceptance identifier printed on the PDF.
  /// Server-generated; a client-supplied value is never trusted.
  acceptanceId String? @unique

  /// The language the Ustaad actually read and accepted. Immutable historical
  /// evidence — changing the app language later must never rewrite this or
  /// the accepted PDF.
  agreementLocale AgreementLocale @default(UR_LATN)

  /// The trade schedule contained in this accepted document. Null for the
  /// general and background documents.
  applicableTrade AgreementTradeCode?

  /// SHA-256 of the approved SOURCE text, as pinned by the registry.
  sourceDocumentHash       String?
  /// SHA-256 of the personalized ACCEPTED document (source + this Ustaad's
  /// data). Differs from sourceDocumentHash by construction.
  acceptedDocumentHash     String?
  /// SHA-256 of the generated PDF bytes, when it differs from the canonical
  /// snapshot hash above.
  acceptedPdfHash          String?
  /// The exact personalized text that was sealed, kept so the record stays
  /// provable even if the PDF file is ever lost.
  acceptedDocumentSnapshot String?

  /// When the Ustaad actually opened this exact document/version/locale.
  /// NULL means it was accepted without being opened — reading is offered,
  /// never required, and this column is never back-filled with the acceptance
  /// time to hide that. Acceptance itself is proven by acceptedAt plus the
  /// version/hash snapshot columns, not by this one.
  documentViewedAt   DateTime?
  acceptanceMethod   AgreementAcceptanceMethod @default(ELECTRONIC_IN_APP)
  /// When the agreement takes effect — normally the acceptance timestamp.
  effectiveAt        DateTime?                 @db.Timestamptz(3)
  /// Set once the generated PDF has been made available to the Ustaad.
  pdfMadeAvailableAt DateTime?

  // ── Identity snapshot (frozen at acceptance) ─────────────────────────────
  fatherNameSnapshot             String?
  dateOfBirthSnapshot            String?
  addressSnapshot                String?
  ustaadAccountIdSnapshot        String?
  emergencyContactSnapshot       String?
  approvedTradeSnapshot          String?
  approvedServiceTagsSnapshot    String?
  verificationProviderSnapshot   String?
  verificationRequestRefSnapshot String?

  /// Scoped to (worker, documentType, version, locale, trade, attempt) so a
  /// retried or double-tapped submission returns the same record instead of
  /// creating a second one.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  /// One acceptance per (worker, template version) — re-submitting against
  /// the same still-active version must not create a duplicate row. A new
  /// template version is a different id, so it naturally requires a new
  /// acceptance row instead of colliding with this constraint. NULL columns
  /// (every CLIENT row) are never considered equal by Postgres, so this never
  /// blocks a CLIENT acceptance.
  @@unique([workerProfileId, agreementTemplateId])
  /// One immutable acceptance per Client per exact agreement version + hash —
  /// the DB-level idempotency guard for the CLIENT flow, mirroring the
  /// constraint above. NULL clientProfileId (every WORKER row) is never
  /// considered equal by Postgres, so this never affects Worker rows.
  @@unique([clientProfileId, agreementType, agreementVersion, agreementHash])
  @@index([workerProfileId])
  @@index([clientProfileId])
  @@index([userId])
  @@index([agreementTemplateId])
  @@map("agreement_acceptances")
}
