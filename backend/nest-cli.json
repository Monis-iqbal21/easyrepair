{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      {
        "include": "modules/agreements/source/documents/**/*",
        "outDir": "dist/src"
      },
      {
        "include": "modules/agreements/source/customer-documents/**/*",
        "outDir": "dist/src"
      }
    ]
  }
}
