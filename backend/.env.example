# ── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/easyrepair?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_this_to_a_long_random_secret

# ── Optional / has defaults ───────────────────────────────────────────────────
PORT=3000
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Number of reverse proxies in front of this app (Express "trust proxy" hop
# count). Must match the real chain or req.ip / the OTP per-IP abuse cap
# resolves to a proxy's address instead of the caller's. Railway behind
# Cloudflare is 1 hop.
TRUST_PROXY_HOPS=1

# Set to true to log the resolved req.ip / X-Forwarded-For / masked phone for
# each OTP request (no OTP, no full phone). Off by default — only needed to
# verify TRUST_PROXY_HOPS is resolving the real client IP after a deploy.
OTP_IP_DEBUG=false

# GET-only machine access for approved operations integrations. Generate a
# random raw key outside the repo, store only its SHA-256 digest here, and put
# the raw key in the approved secret manager. Leave unset to disable access.
ADMIN_READONLY_API_KEY_SHA256=
ADMIN_READONLY_CLIENT_ID=
ADMIN_READONLY_SCOPES=
ADMIN_READONLY_EXPIRES_AT=
ADMIN_READONLY_RATE_LIMIT_PER_MINUTE=120

# ── Firebase (optional — push notifications won't work without it) ────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── SMS (optional — VeevoTech; OTP login/registration won't send real SMS without it) ──
SMS_API_KEY=
SMS_API_URL=https://api.veevotech.com/v3/sendsms
SMS_SENDER=Default

# ── Cloudflare R2 storage (optional — file uploads won't work without it) ────
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
R2_ENDPOINT=

# ── Platform ──────────────────────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=10

# ── PostGIS (set true only if your local Postgres has PostGIS installed) ──────
USE_POSTGIS=false
