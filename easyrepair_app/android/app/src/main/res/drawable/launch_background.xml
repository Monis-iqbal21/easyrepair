<?xml version="1.0" encoding="utf-8"?>
<!--
  HandyGo launch screen (pre-API 21). Colour comes from
  @color/handygo_splash_background - see values/colors.xml, the single place
  it is defined. Do not inline a hex value here.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/handygo_splash_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/handygo_splash_logo" />
    </item>
</layer-list>
