<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark-mode launch theme. The branded artwork is intentionally the SAME in
      both modes for now (no dark splash asset exists yet), so this points at
      the same drawable and the same @color/handygo_splash_background as the
      light theme. When a dark palette/asset is introduced, override
      handygo_splash_background in values-night/colors.xml - that stays the
      single place the colour is decided.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/handygo_splash_background</item>
    </style>
</resources>
