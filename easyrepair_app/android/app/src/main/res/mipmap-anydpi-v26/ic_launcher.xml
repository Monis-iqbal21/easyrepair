<?xml version="1.0" encoding="utf-8"?>
<!--
  HandyGo's adaptive launcher icon (API 26+), regenerated by
  flutter_launcher_icons from assets/images/logo-final.png - see the
  flutter_launcher_icons block in pubspec.yaml.

  Background is the flat brand teal, foreground the off-white wrench: the same
  way round as logo-final.png. A teal mark on an off-white tile is the
  inverse of the approved icon and must not come back.

  No <inset> here. The safe-zone padding is baked into
  assets/images/logo-adaptive-foreground.png (the mark is pre-scaled by
  72/108), so this file stays exactly what the generator emits and a rerun of
  the tool cannot silently drop a hand-added inset - or, worse, apply it twice
  and shrink the mark to a speck.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
