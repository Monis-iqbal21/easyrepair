<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ (API 31) replaced the windowBackground launch screen with
      the system splash API. Only the attributes below are honoured; a custom
      layout is not possible, so this is the closest supported match rather
      than a reproduction of the Flutter screen.

      windowSplashScreenAnimatedIcon is @drawable/handygo_splash_icon: the
      off-white wrench padded to ~66% of a square canvas. The platform masks
      this icon to a circle and only guarantees the inner two thirds, so the
      padding is what keeps the wrench whole. It is deliberately the wrench
      ALONE - no wordmark, no tagline - which is also why it is not the
      launcher icon.

      The background colour is the shared value from values/colors.xml - the
      single place it is defined. Not duplicated as a hex literal here.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/handygo_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/handygo_splash_icon</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/handygo_splash_background</item>
    </style>
</resources>
