<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#FFFEFB</color>

    <!--
      ============================================================
      HANDYGO NATIVE SPLASH COLOUR - SINGLE SOURCE OF TRUTH
      ============================================================
      This is the ONLY place the Android launch-screen colour is defined.
      Everything that needs it references @color/handygo_splash_background:

        * drawable/launch_background.xml          (pre-API 21)
        * drawable-v21/launch_background.xml      (API 21-30)
        * values-v31/styles.xml                   (Android 12+ splash API)
        * values-night/styles.xml                 (via the same drawables)

      WHY THIS VALUE: #082B28 is HandyGo's startup teal - the deep end of the
      brand teal that the primary #11645D sits in. The native launch screen
      shows this colour with the off-white wrench centred on it and NOTHING
      else: no wordmark, no tagline, no spinner. Flutter then paints its own
      loading/welcome screen in the primary teal, so the hand-off is one step
      within a single hue rather than a flash between unrelated colours.

      Native launch resources cannot read Flutter's runtime theme, so this
      literal is deliberate and correct here - it is the platform counterpart
      of AppSemanticColors, not a hardcoded colour escaping the design system.
      Its Flutter-side sibling is lib/core/theme/app_semantic_colors.dart and
      its iOS counterpart is ios/Runner/Base.lproj/LaunchScreen.storyboard.
    -->
    <color name="handygo_splash_background">#082B28</color>
</resources>
