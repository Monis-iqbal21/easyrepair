<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Theme applied to the Android Window while the process is starting.
      The launch drawable it points at is composed in
      drawable/launch_background.xml (and drawable-v21) from
      @color/handygo_splash_background - see values/colors.xml.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!--
      Theme applied as soon as the process has started, and used behind the
      Flutter UI while it initialises. Held on the same fallback colour so the
      window never flashes white between the launch drawable disappearing and
      Flutter's first frame.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/handygo_splash_background</item>
    </style>
</resources>
